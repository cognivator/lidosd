# /etc/sudoers.d/lidosd  (mode 440, root:wheel)
# TEMPLATE: install.sh substitutes the group name (--group) and installs the result.
# Lets members of group @@SLEEP_GROUP@@ arm / disarm the lid-close OSD without a password.
# The "" entry means "no arguments allowed"; `disarm` is listed explicitly.
# Do NOT allow bare `lidosd` with any arguments (that would expose `daemon`).
#
# `visudo -cf` is EXPECTED TO FAIL on this template; validate the substituted
# (staged) copy that install.sh writes, not this file.
%@@SLEEP_GROUP@@ ALL=(root) NOPASSWD: /Library/PrivilegedHelperTools/lidosd "", /Library/PrivilegedHelperTools/lidosd disarm
