#!/bin/bash
# lidosd - One-Shot Disable (OSD) of lid-close sleep for macOS (Monterey, Intel)
#
# Usage:
#   lidosd           arm the OSD: lid-close sleep is disabled until the lid has
#                    been closed and then reopened (auto re-enable), until
#                    `lidosd disarm` is run, or until the AnythingLLM container
#                    stops - whichever happens first
#   lidosd disarm    re-enable lid-close sleep immediately
#   lidosd status    show state, SleepDisabled flag, lid position
#   lidosd daemon    internal: watcher loop run by launchd as root
#
# Mechanism
#   * Lid-close sleep is suppressed with `pmset -a disablesleep 1` (root only).
#     This blocks ALL sleep, not only lid-close, so it is held only while armed.
#   * A root LaunchDaemon polls every POLL seconds (5) and runs a small state
#     machine persisted in /var/db/lidosd/state:
#
#        idle --(lidosd)--> armed --(lid closes)--> closed --(lid opens)--> idle
#                             |                        |
#                             +--(lidosd disarm)-------+--> idle
#                             +--(container stops)-----+--> idle
#
#     Lid position comes from IOKit AppleClamshellState (Yes = closed).
#     On every transition to idle, `pmset -a disablesleep 0` is applied.
#   * "Container" = the Docker container CONTAINER, asked as OWNER_USER with
#     `sudo -u OWNER_USER -H docker inspect` (the same check as
#     anythingllm-caffeinate.sh). Arming is refused if the first check fails;
#     while armed or closed, FAIL_LIMIT consecutive failed checks disarm.
#
# Security (this script runs as root, and OWNER_USER can reach it through sudo)
#   * PATH and umask are fixed; every external tool is called by absolute path
#     or from the fixed PATH.
#   * Constants are fixed in this file. Environment variables are NOT consulted,
#     except in test mode (LIDOSD_TEST=1), which is ignored whenever sudo started
#     the process (SUDO_USER set) and so cannot be turned on by an unprivileged
#     caller.
#   * An unprivileged caller is re-executed through `sudo -n` on the FIXED path
#     /Library/PrivilegedHelperTools/lidosd with canonical arguments (never $0 / caller input).
#     See lidosd.sudoers, which allows only `lidosd` and `lidosd disarm`.
#     At most one argument is accepted, and it must be arm | disarm | status | daemon.
#   * The container check runs as OWNER_USER (`sudo -n -u OWNER_USER -H`, absolute
#     docker path, bounded by CHECK_TIMEOUT). Its answer is untrusted: only the
#     exact text "true" counts, and an error or a hang counts as not running.
#     That account controls its own docker config, so the check gates stale
#     arms; it does not bound a caller that wants to stay armed.
#   * The state directory must be a real directory owned by root and not
#     group/other-writable; otherwise lidosd refuses to read or write state.
#     A missing, unreadable or unrecognized state fails safe to "disarm".
#
# Polling trade-off: a lid close+reopen faster than POLL seconds can be missed;
# the OSD then simply stays armed until the next observed close/reopen, or
# `lidosd disarm`, or the container stops.
#
# Install as root-owned, mode 755, in a root-owned directory (/Library/PrivilegedHelperTools);
# install.sh checks this.

PATH=/usr/bin:/bin:/usr/sbin:/sbin
export PATH
umask 022
set -u

# ---- constants. Keep OWNER_USER / DOCKER / CONTAINER in sync with
# ---- anythingllm-caffeinate.sh, lidosd.sudoers and install.sh (install.sh
# ---- checks OWNER_USER).
OWNER_USER=llmserver
DOCKER=/usr/local/bin/docker
CONTAINER=anythingllm
SELF=/Library/PrivilegedHelperTools/lidosd
SUDO=/usr/bin/sudo
PMSET=/usr/bin/pmset
IOREG=/usr/sbin/ioreg
STATE_DIR=/var/db/lidosd
POLL=5
CHECK_TIMEOUT=4     # seconds before a container check is killed
FAIL_LIMIT=3        # consecutive failed checks (armed or closed) before disarm
SKIP_ROOT=0

# ---- test mode (never honored under sudo)
if [ "${LIDOSD_TEST:-}" = 1 ] && [ -z "${SUDO_USER:-}" ]; then
    OWNER_USER=${LIDOSD_OWNER_USER:-$OWNER_USER}
    DOCKER=${LIDOSD_DOCKER:-$DOCKER}
    CONTAINER=${LIDOSD_CONTAINER:-$CONTAINER}
    SUDO=${LIDOSD_SUDO:-$SUDO}
    PMSET=${LIDOSD_PMSET:-$PMSET}
    IOREG=${LIDOSD_IOREG:-$IOREG}
    STATE_DIR=${LIDOSD_STATE_DIR:-$STATE_DIR}
    POLL=${LIDOSD_POLL:-$POLL}
    CHECK_TIMEOUT=${LIDOSD_CHECK_TIMEOUT:-$CHECK_TIMEOUT}
    SKIP_ROOT=${LIDOSD_SKIP_ROOT:-0}
fi
STATE_FILE="$STATE_DIR/state"

log() { echo "$(date '+%Y-%m-%d %H:%M:%S') lidosd: $*"; }

usage() { echo "usage: lidosd [disarm|status]" >&2; exit 2; }

# need_root [ARGS...] : if not root, re-exec through sudo with a fixed path and
# canonical arguments (so sudoers matches exactly); otherwise continue.
need_root() {
    if [ "$(id -u)" -ne 0 ] && [ "$SKIP_ROOT" != 1 ]; then
        exec "$SUDO" -n "$SELF" "$@"
    fi
}

lid_closed() {
    "$IOREG" -r -k AppleClamshellState -d 4 2>/dev/null \
        | grep -q 'AppleClamshellState" = Yes'
}

# True only if `docker inspect`, run AS $OWNER_USER, prints exactly "true".
# The answer is untrusted (that account controls its own docker config), so
# anything else, a failure, or a call outliving CHECK_TIMEOUT counts as not
# running. macOS has no timeout(1): a background watchdog kills the call.
container_running() {
    local out
    out=$(
        "$SUDO" -n -u "$OWNER_USER" -H "$DOCKER" inspect \
            --format '{{.State.Running}}' "$CONTAINER" 2>/dev/null &
        cpid=$!
        ( sleep "$CHECK_TIMEOUT"; kill "$cpid" 2>/dev/null
          sleep 1; kill -9 "$cpid" 2>/dev/null ) >/dev/null 2>&1 &
        wpid=$!
        wait "$cpid" 2>/dev/null
        kill "$wpid" 2>/dev/null
    )
    [ "$out" = true ]
}

ensure_state_dir() {
    if [ ! -e "$STATE_DIR" ]; then
        mkdir -p "$STATE_DIR" && chmod 755 "$STATE_DIR" || return 1
    fi
    if [ -L "$STATE_DIR" ] || [ ! -d "$STATE_DIR" ] \
       || [ -z "$(find "$STATE_DIR" -maxdepth 0 -user root 2>/dev/null)" ] \
       || [ -n "$(find "$STATE_DIR" -maxdepth 0 \( -perm -020 -o -perm -002 \) 2>/dev/null)" ]; then
        echo "lidosd: unsafe state directory $STATE_DIR (must be a real directory owned by root, not group/other-writable)" >&2
        return 1
    fi
}

# idle | armed | closed | invalid ; a missing file means idle
get_state() {
    local s
    if [ -L "$STATE_FILE" ]; then echo invalid; return; fi
    if [ ! -e "$STATE_FILE" ]; then echo idle; return; fi
    s=$(cat "$STATE_FILE" 2>/dev/null) || { echo invalid; return; }
    case "$s" in
        idle|armed|closed) echo "$s" ;;
        *)                 echo invalid ;;
    esac
}

set_state() {
    ensure_state_dir || return 1
    rm -f "$STATE_FILE.tmp"
    ( set -C; printf '%s\n' "$1" > "$STATE_FILE.tmp" ) && mv -f "$STATE_FILE.tmp" "$STATE_FILE" \
        && chmod 644 "$STATE_FILE"
}

arm() {
    if ! container_running; then
        echo "lidosd: container $CONTAINER is not running (checked as $OWNER_USER); not arming." >&2
        exit 1
    fi
    set_state armed || exit 1
    "$PMSET" -a disablesleep 1
    log "armed: lid-close sleep disabled until lid closes and reopens (or container stops)"
    if lid_closed; then
        echo "Note: lid is already closed; the Mac may have slept or be in clamshell mode." >&2
    fi
}

# Sleep is re-enabled FIRST; recording the state is best effort.
disarm() {
    "$PMSET" -a disablesleep 0
    set_state idle || echo "lidosd: warning: could not record state 'idle'" >&2
    log "disarmed: lid-close sleep enabled"
}

daemon() {
    local state fails=0
    trap 'disarm; exit 0' TERM INT

    # Reconcile after a (re)start so a crash cannot leave sleep disabled forever.
    # One failed check is enough here: a failure fails safe to disarm.
    state=$(get_state)
    if [ "$state" != idle ] && ! container_running; then
        log "container $CONTAINER (as $OWNER_USER) not running at startup"
        disarm
    else
        case "$state" in
            idle)   "$PMSET" -a disablesleep 0 ;;
            armed)  "$PMSET" -a disablesleep 1 ;;
            closed) if lid_closed; then "$PMSET" -a disablesleep 1; else disarm; fi ;;
            *)      disarm ;;
        esac
    fi
    log "daemon started (poll=${POLL}s), state=$(get_state)"

    while true; do
        # sleep in background + wait, so TERM/INT is handled immediately
        sleep "$POLL" & wait $!

        state=$(get_state)
        if [ "$state" = idle ]; then fails=0; continue; fi

        if [ "$state" = invalid ]; then
            log "unreadable or unrecognized state; failing safe"
            fails=0
            disarm
            continue
        fi

        # armed or closed: a hung or failed check counts; FAIL_LIMIT in a row disarm
        if container_running; then
            fails=0
        else
            fails=$((fails + 1))
            if [ "$fails" -lt "$FAIL_LIMIT" ]; then continue; fi
            log "container $CONTAINER (as $OWNER_USER) not running ($fails consecutive checks)"
            fails=0
            disarm
            continue
        fi

        case "$state" in
            armed)  if lid_closed; then set_state closed && log "lid closed while armed"; fi ;;
            closed) if ! lid_closed; then log "lid reopened"; disarm; fi ;;
        esac
    done
}

status() {
    echo "state:         $(get_state)"
    echo "lid:           $(lid_closed && echo closed || echo open)"
    echo "container:     checked by the daemon while armed"
    echo "SleepDisabled: $("$PMSET" -g 2>/dev/null | awk '/SleepDisabled/ {print $2}')"
}

[ $# -le 1 ] || usage

case "${1:-arm}" in
    arm)     need_root; arm ;;
    disarm)  need_root disarm; disarm ;;
    status)  status ;;
    daemon)
        if [ "$(id -u)" -ne 0 ]; then
            echo "lidosd: 'daemon' runs as root under launchd; not meant to be run by hand" >&2
            exit 1
        fi
        daemon ;;
    *)       usage ;;
esac
