<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- LaunchAgent for the llmserver account (runs in its GUI session).
     Install to /Users/llmserver/Library/LaunchAgents/ -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.llmserver.anythingllm-caffeinate</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/llmserver/bin/anythingllm-caffeinate.sh</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/tmp/anythingllm-caffeinate.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/anythingllm-caffeinate.log</string>
</dict>
</plist>
