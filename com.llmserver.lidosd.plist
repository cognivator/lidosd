<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- LaunchDaemon (runs as root, system-wide).
     Install to /Library/LaunchDaemons/ as root:wheel, mode 644. -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.llmserver.lidosd</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/sbin/lidosd</string>
        <string>daemon</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/var/log/lidosd.log</string>
    <key>StandardErrorPath</key>
    <string>/var/log/lidosd.log</string>
</dict>
</plist>
